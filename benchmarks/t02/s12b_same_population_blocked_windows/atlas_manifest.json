{
  "schema_version": "0.3",
  "table": {
    "path": "table.csv",
    "format": "csv"
  },
  "columns": {
    "row_id": "row_id",
    "target": "state",
    "class_map": {
      "0": "idle",
      "1": "active"
    },
    "features": [
      "f0",
      "f1",
      "f2"
    ],
    "observation_id": "observation_id",
    "stream_id": "stream_id",
    "window_start": "window_start",
    "window_end": "window_end"
  },
  "claim": {
    "type": "same_population",
    "statement": "The classifier works on new windows from these same sensors.",
    "sampling_unit": "row",
    "dependence": [
      {
        "kind": "overlapping_windows"
      },
      {
        "kind": "temporal_order"
      }
    ]
  },
  "time_basis": {
    "unit": "sample",
    "reference_time": "start of each sensor stream (synthetic)",
    "scope": "per_stream"
  },
  "separation_rule": {
    "scope": "per_stream",
    "min_gap": 5,
    "times": "window"
  },
  "primary_metric": "balanced_accuracy",
  "development_seeds": [
    0
  ],
  "entry_point": "evaluate.py"
}
