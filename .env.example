# Copy to .env (git-ignored) and fill in locally. Never commit real values.
# Runtime inference: NVIDIA model via Nebius Token Factory (playbook Section 7).
NEBIUS_API_KEY=replace_with_local_secret
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Use only model IDs confirmed by an authenticated GET /models call.
ATLAS_MODEL_PRIMARY=replace_with_verified_model_id
ATLAS_MODEL_FAST=
# live | fixture  (fixture mode must be visibly labeled as non-live)
ATLAS_MODEL_MODE=fixture
